// OUTLYY — Inquiry Mode backend schema.
//
// Source of truth: docs/backend/05-database-design.md as amended by
// docs/backend/17-inquiry-mode-pivot.md §6. Every table the pivot marks
// ACTIVE is here in full; the money path (orders, order_items, payments,
// attribution) is here in the shape §05 specifies so that
// `inquiry.convertToOrder()` is a column copy, not a translation. Tables the
// pivot marks FUTURE (quotes, availability_cache, capacity_ledger, vouchers,
// refunds, supplier_bookings) are intentionally absent — adding them later is
// additive and touches nothing here.
//
// Conventions (§05.1):
//   - money is BigInt in minor units (paise / fils), never Float
//   - all timestamps timestamptz UTC; service dates are DATE + timeslot text
//   - UUID primary keys generated in code (uuidv7, src/server/lib/ids.ts)
//   - soft delete via deleted_at where an order can reference the row
//   - constraints Prisma cannot express live in prisma/migrations/*/migration.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * ---------------------------------------------------------------------------
 * Enums — closed, stable sets (§05.1 rule 5)
 * ------------------------------------------------------------------------
 */

enum FulfilmentMode {
  inquiry
  instant

  @@map("fulfilment_mode")
}

enum ConfirmationType {
  instant
  manual

  @@map("confirmation_type")
}

enum InquiryStatus {
  new
  assigned
  contacted
  quoted
  negotiating
  payment_pending
  won
  lost
  spam

  @@map("inquiry_status")
}

enum InquirySource {
  inquiry_form
  whatsapp
  concierge
  contact_form
  quote_request
  agent_created
  abandoned_cart

  @@map("inquiry_source")
}

enum ActorType {
  customer
  agent
  admin
  system
  supplier

  @@map("actor_type")
}

enum InquiryEventKind {
  status
  note
  assignment
  contact
  item
  system

  @@map("inquiry_event_kind")
}

enum Currency {
  INR
  AED

  @@map("currency")
}

enum AdminStatus {
  active
  suspended

  @@map("admin_status")
}

enum AgentStatus {
  available
  busy
  away
  offline

  @@map("agent_status")
}

enum NotificationChannel {
  whatsapp
  email
  sms
  push

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
  suppressed

  @@map("notification_status")
}

enum ConsentChannel {
  whatsapp
  email
  sms
  push

  @@map("consent_channel")
}

enum ConsentPurpose {
  transactional
  marketing
  recovery

  @@map("consent_purpose")
}

enum OrderStatus {
  pending_payment
  payment_failed
  paid
  supplier_pending
  confirmed
  partially_confirmed
  cancelled
  refunded
  completed

  @@map("order_status")
}

enum OrderItemStatus {
  pending
  confirmed
  rejected
  cancelled
  completed

  @@map("order_item_status")
}

enum Rail {
  self_serve
  assisted

  @@map("rail")
}

enum PaymentCollection {
  gateway
  manual_link
  bank_transfer

  @@map("payment_collection")
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum SupplierSource {
  direct
  api
  portal

  @@map("supplier_source")
}

enum SupplierStatus {
  active
  paused
  terminated

  @@map("supplier_status")
}

enum AnalyticsSource {
  client
  server

  @@map("analytics_source")
}

enum JobStatus {
  running
  succeeded
  failed
  dead

  @@map("job_status")
}

enum WaConversationStatus {
  open
  pending
  resolved
  snoozed

  @@map("wa_conversation_status")
}

/**
 * ---------------------------------------------------------------------------
 * Admin, roles, audit (§05.3.10, §09.4, §13)
 * ------------------------------------------------------------------------
 */

model AdminUser {
  id                  String      @id @db.Uuid
  /// Stored lowercased; uniqueness enforced case-insensitively by normalising on write.
  email               String      @unique
  fullName            String      @map("full_name")
  passwordHash        String      @map("password_hash")
  totpSecretEncrypted String?     @map("totp_secret_encrypted")
  totpEnabled         Boolean     @default(false) @map("totp_enabled")
  status              AdminStatus @default(active)
  /// "Named agent, real photo" (PRD §1) — shown to customers on the confirmation page and in the ack.
  whatsappDisplayName String?     @map("whatsapp_display_name")
  photoUrl            String?     @map("photo_url")
  failedLoginCount    Int         @default(0) @map("failed_login_count")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)

  roles             AdminUserRole[]
  sessions          AdminSession[]
  availability      AgentAvailability?
  assignedInquiries Inquiry[]          @relation("InquiryAssignedAgent")
  ordersCreated     Order[]            @relation("OrderCreatedByAgent")
  settingsUpdated   Setting[]
  waConversations   WaConversation[]

  @@index([status], map: "admin_users_status_idx")
  @@map("admin_users")
}

model Role {
  id          String           @id @db.Uuid
  code        String           @unique
  name        String
  permissions RolePermission[]
  users       AdminUserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  user        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

/// Refresh-token family for admin/agent sessions (§13.2.2). Hash only, never the token.
model AdminSession {
  id          String    @id @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  userAgent   String?   @map("user_agent")
  ipHash      String?   @map("ip_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt], map: "admin_sessions_user_idx")
  @@index([refreshHash], map: "admin_sessions_refresh_idx")
  @@map("admin_sessions")
}

/**
 * ---------------------------------------------------------------------------
 * Customers — phone-OTP identity (docs/backend/impl/customer-auth-contract.md §2).
 * An account is created implicitly on the first successful OTP verify; the
 * inquiry form never requires one (guest-first). Inquiries and orders are
 * linked by *verified* phone only (§13.2.1), never by a claimed one.
 * ------------------------------------------------------------------------
 */

model Customer {
  id                String    @id @db.Uuid
  /// E.164 — the identity. Verified by OTP before the row exists.
  phoneE164         String    @unique @map("phone_e164")
  /// Stored lowercased. Optional; never used to sign in.
  email             String?
  fullName          String?   @map("full_name")
  /// 'veg' | 'jain' | 'halal' | 'non-veg' (src/lib/types.ts Dietary)
  dietary           String?
  hotel             String?
  locale            String    @default("en-IN")
  preferredCurrency Currency  @default(INR) @map("preferred_currency")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Set by the §05.8 anonymisation (ops action) — the row stays for FK integrity.
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessions  CustomerSession[]
  inquiries Inquiry[]
  orders    Order[]

  @@map("customers")
}

/// Opaque bearer session — the token is random, only its SHA-256 is stored. 30-day sliding expiry.
model CustomerSession {
  id         String    @id @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipHash     String?   @map("ip_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, revokedAt], map: "customer_sessions_customer_idx")
  @@map("customer_sessions")
}

/// One OTP request. Code stored as SHA-256(challenge id : code), 5-minute TTL, single-use, max attempts (§13.2.1).
model OtpChallenge {
  id         String    @id @db.Uuid
  phoneE164  String    @map("phone_e164")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneE164, createdAt(sort: Desc)], map: "otp_challenges_phone_idx")
  @@map("otp_challenges")
}

/// §09.5 — routing inputs for lead assignment (§17 §7.3).
model AgentAvailability {
  agentId       String      @id @map("agent_id") @db.Uuid
  status        AgentStatus @default(available)
  maxConcurrent Int         @default(8) @map("max_concurrent")
  /// 'hindi','luxury','groups','abu-dhabi','uae-shift','senior'
  skills        String[]    @default([])
  languages     String[]    @default([])
  /// 'IST' | 'GST' — which shift the agent covers (§17 §7.3 rule 3)
  shift         String      @default("IST")
  /// Customer-facing title, e.g. "Dubai trip specialist"
  title         String?
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent         AdminUser   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_availability")
}

/// AC-ADM-01. Append-only at the grant level (see migration SQL).
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ipHash     String?   @map("ip_hash")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_logs_entity_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "audit_logs_actor_idx")
  @@map("audit_logs")
}

/// Admin-editable configuration without a deploy (AC-SRCH-05, §17 §6.4 sla.*).
model Setting {
  key       String     @id
  value     Json
  updatedBy String?    @map("updated_by") @db.Uuid
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updater   AdminUser? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

model FeatureFlag {
  key        String   @id
  enabled    Boolean  @default(false)
  rolloutPct Int      @default(0) @map("rollout_pct")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

/**
 * ---------------------------------------------------------------------------
 * Catalogue — minimal. The storefront still reads the hand-checked fixtures in
 * src/lib/data/*.ts (§10.2.4 keeps them as fixtures). What lives here is what
 * the backend must own: identity for FK integrity, the per-product
 * `fulfilment_mode` hinge (§17 §6.4), and supplier mappings for Rathin.
 * ------------------------------------------------------------------------
 */

model Supplier {
  id               String         @id @db.Uuid
  code             String         @unique
  name             String
  source           SupplierSource
  /// 'rathin' | 'manual' | 'portal' — selects the SupplierPort adapter (§02)
  adapter          String
  capabilities     Json           @default("{}")
  contactName      String?        @map("contact_name")
  contactWhatsapp  String?        @map("contact_whatsapp")
  contactEmail     String?        @map("contact_email")
  emergencyPhone   String?        @map("emergency_phone")
  reliabilityScore Decimal        @default(80) @map("reliability_score") @db.Decimal(5, 2)
  status           SupplierStatus @default(active)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)

  mappings ProductSupplierMapping[]

  @@map("suppliers")
}

model Product {
  id              String           @id @db.Uuid
  slug            String           @unique
  title           String
  tier            String           @db.Char(1)
  status          String           @default("published")
  categorySlug    String           @map("category_slug")
  confirmation    ConfirmationType
  /// THE HINGE (§17 §6.4). Per product, never site-wide. Rollback = set it back.
  fulfilmentMode  FulfilmentMode   @default(inquiry) @map("fulfilment_mode")
  quoteOnly       Boolean          @default(false) @map("quote_only")
  /// Full `Activity` document (src/lib/types.ts), validated by activitySchema on every write.
  /// Scalar columns below are synced projections for listing/search — never edited on their own.
  content         Json             @default("{}")
  subtitle        String?
  location        String?
  durationMinutes Int?             @map("duration_minutes")
  priceFromInr    BigInt?          @map("price_from_inr")
  priceFromAed    BigInt?          @map("price_from_aed")
  rating          Decimal?         @db.Decimal(2, 1)
  reviewCount     Int?             @map("review_count")
  isPrivate       Boolean          @default(false) @map("is_private")
  pickupIncluded  Boolean          @default(false) @map("pickup_included")
  dietary         String[]         @default([])
  suitability     String[]         @default([])
  version         Int              @default(1)
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(6)
  seoTitle        String?          @map("seo_title")
  seoDescription  String?          @map("seo_description")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  mappings     ProductSupplierMapping[]
  inquiryItems InquiryItem[]
  orderItems   OrderItem[]
  versions     ProductVersion[]
  importItems  ImportBatchItem[]

  @@index([tier, status], map: "products_tier_status_idx")
  @@index([categorySlug, status], map: "products_category_status_idx")
  @@index([status, deletedAt], map: "products_status_deleted_idx")
  @@map("products")
}

/// Append-only history of every product write. `restoreVersion` writes a new
/// version equal to an old one — history is never rewritten.
model ProductVersion {
  id        String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  version   Int
  content   Json
  status    String
  actorId   String?  @map("actor_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@index([productId, version(sort: Desc)], map: "product_versions_product_version_idx")
  @@map("product_versions")
}

model Category {
  id            String    @id @db.Uuid
  slug          String    @unique
  name          String
  shortName     String    @map("short_name")
  emoji         String    @default("")
  tagline       String    @default("")
  intro         String    @default("")
  heroImage     String    @default("") @map("hero_image")
  faqs          Json      @default("[]")
  relatedSlugs  String[]  @default([]) @map("related_slugs")
  featuredSlugs String[]  @default([]) @map("featured_slugs")
  sortOrder     Int       @default(100) @map("sort_order")
  status        String    @default("published")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status, sortOrder], map: "categories_status_sort_idx")
  @@map("categories")
}

/// One import run (CSV / Google Sheet / Google Doc / bulk JSON / manual batch).
/// `preview` holds the validated rows so apply() re-uses exactly what the
/// admin approved; `errors` holds per-row problems shown in the wizard.
model ImportBatch {
  id         String            @id @db.Uuid
  source     String
  status     String            @default("previewed")
  fileName   String?           @map("file_name")
  sourceRef  String?           @map("source_ref")
  mapping    Json              @default("{}")
  rowsTotal  Int               @default(0) @map("rows_total")
  rowsOk     Int               @default(0) @map("rows_ok")
  rowsFailed Int               @default(0) @map("rows_failed")
  errors     Json              @default("[]")
  preview    Json              @default("[]")
  createdBy  String            @map("created_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  appliedAt  DateTime?         @map("applied_at") @db.Timestamptz(6)
  revertedAt DateTime?         @map("reverted_at") @db.Timestamptz(6)
  items      ImportBatchItem[]

  @@index([createdAt(sort: Desc)], map: "import_batches_created_idx")
  @@map("import_batches")
}

model ImportBatchItem {
  id            String      @id @db.Uuid
  batchId       String      @map("batch_id") @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  action        String
  beforeVersion Int?        @map("before_version")
  afterVersion  Int         @map("after_version")
  slug          String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([batchId], map: "import_batch_items_batch_idx")
  @@map("import_batch_items")
}

model Combo {
  id             String           @id @db.Uuid
  slug           String           @unique
  name           String
  tier           String           @default("C") @db.Char(1)
  status         String           @default("published")
  confirmation   ConfirmationType
  fulfilmentMode FulfilmentMode   @default(inquiry) @map("fulfilment_mode")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  inquiryItems InquiryItem[]
  orderItems   OrderItem[]

  @@map("combos")
}

/// `external_ref` is opaque JSONB on purpose: Rathin's identifier shape is
/// unknown until the §16 spike; a new adapter needs no migration.
model ProductSupplierMapping {
  id          String   @id @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  variantCode String?  @map("variant_code")
  priority    Int      @default(1)
  externalRef Json     @default("{}") @map("external_ref")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product     Product  @relation(fields: [productId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId, variantCode])
  @@index([productId, priority], map: "psm_product_priority_idx")
  @@map("product_supplier_mappings")
}

/**
 * ---------------------------------------------------------------------------
 * Inquiry pipeline — the core system (§17 §6.1–6.3)
 * ------------------------------------------------------------------------
 */

model Inquiry {
  id                String        @id @db.Uuid
  /// INQ-104821 — sequence + checksum, human-facing (§05.1 rule 7)
  reference         String        @unique
  status            InquiryStatus @default(new)
  source            InquirySource
  channelPreference String?       @map("channel_preference")

  // identity — guest-first, exactly as orders
  leadName        String  @map("lead_name")
  /// E.164, the only channel that matters
  leadPhone       String  @map("lead_phone")
  leadEmail       String? @map("lead_email")
  countryCode     String  @map("country_code")
  whatsappConsent Boolean @default(true) @map("whatsapp_consent")

  // trip shape
  travelDateFrom  DateTime? @map("travel_date_from") @db.Date
  travelDateTo    DateTime? @map("travel_date_to") @db.Date
  datesFlexible   Boolean   @default(false) @map("dates_flexible")
  pax             Json?
  hotel           String?
  pickupZone      String?   @map("pickup_zone")
  dietary         String?
  specialRequests String?   @map("special_requests")
  budgetBand      String?   @map("budget_band")

  // indicative economics, snapshotted at submission (minor units)
  currency             Currency @default(INR)
  indicativeTotalInr   BigInt   @default(0) @map("indicative_total_inr")
  indicativeTotalAed   BigInt   @default(0) @map("indicative_total_aed")
  indicativeNetCostAed BigInt   @default(0) @map("indicative_net_cost_aed")

  // SLA and ownership
  assignedAgentId String?   @map("assigned_agent_id") @db.Uuid
  assignedAt      DateTime? @map("assigned_at") @db.Timestamptz(6)
  slaDueAt        DateTime? @map("sla_due_at") @db.Timestamptz(6)
  slaBreachedAt   DateTime? @map("sla_breached_at") @db.Timestamptz(6)
  escalatedAt     DateTime? @map("escalated_at") @db.Timestamptz(6)
  /// The 30-minute measurement (§17 §7.2 step 14)
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(6)
  lastContactAt   DateTime? @map("last_contact_at") @db.Timestamptz(6)
  nextFollowupAt  DateTime? @map("next_followup_at") @db.Timestamptz(6)
  /// 0 = none sent; 1..3 = ladder step (§17 §7.2 follow-up ladder)
  followupStage   Int       @default(0) @map("followup_stage")
  ackSentAt       DateTime? @map("ack_sent_at") @db.Timestamptz(6)

  // outcome — THE HINGE
  convertedOrderId String?   @unique @map("converted_order_id") @db.Uuid
  lostReason       String?   @map("lost_reason")
  lostAt           DateTime? @map("lost_at") @db.Timestamptz(6)

  // attribution captured at submission (§17 §8.4) — copied to order_attribution on win
  attribution Json?
  sessionId   String? @map("session_id")
  anonId      String? @map("anon_id")
  ipHash      String? @map("ip_hash")
  userAgent   String? @map("user_agent")
  /// Spam signals recorded, never used to silently drop (§17 §9): {honeypot, elapsedMs, suppressed}
  spamSignals Json?   @map("spam_signals")

  waConversationId String?  @map("wa_conversation_id") @db.Uuid
  /// Linked on OTP verify when lead_phone equals the verified phone (customer-auth-contract §1). Never set from a claimed phone.
  customerId       String?  @map("customer_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedAgent  AdminUser?       @relation("InquiryAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  convertedOrder Order?           @relation("InquiryConvertedOrder", fields: [convertedOrderId], references: [id])
  waConversation WaConversation?  @relation(fields: [waConversationId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          InquiryItem[]
  events         InquiryEvent[]
  notifications  Notification[]
  analytics      AnalyticsEvent[]
  /// Orders that cite this inquiry as their source (§17 §6.4). Normally at most one.
  sourcedOrders  Order[]          @relation("OrderSourceInquiry")

  @@index([status, slaDueAt], map: "inquiries_status_sla_idx")
  @@index([assignedAgentId, status], map: "inquiries_agent_status_idx")
  @@index([leadPhone], map: "inquiries_lead_phone_idx")
  @@index([createdAt(sort: Desc)], map: "inquiries_created_idx")
  @@index([nextFollowupAt], map: "inquiries_followup_idx")
  @@index([customerId], map: "inquiries_customer_idx")
  @@map("inquiries")
}

/// Deliberately mirrors order_items column-for-column (§17 §6.2). Converting a
/// won inquiry to an order is a field copy: indicative_* → unit/total, with
/// confirmed_* winning where present.
model InquiryItem {
  id          String    @id @db.Uuid
  inquiryId   String    @map("inquiry_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  comboId     String?   @map("combo_id") @db.Uuid
  /// Variant ids in the catalogue are stable string codes ("std", "vip")
  variantCode String?   @map("variant_code")
  serviceDate DateTime? @map("service_date") @db.Date
  timeslot    String?
  pax         Json
  addons      Json      @default("[]")

  // snapshots, same fields as order_items
  titleSnapshot                 String           @map("title_snapshot")
  tierSnapshot                  String           @map("tier_snapshot") @db.Char(1)
  slugSnapshot                  String           @map("slug_snapshot")
  kindSnapshot                  String           @map("kind_snapshot")
  imageSnapshot                 String?          @map("image_snapshot")
  variantNameSnapshot           String?          @map("variant_name_snapshot")
  /// What the customer was shown at submission; copied verbatim into order_items on win.
  inclusionsSnapshot            String[]         @default([]) @map("inclusions_snapshot")
  cancellationPolicySnapshot    Json             @default("{}") @map("cancellation_policy_snapshot")
  confirmationSnapshot          ConfirmationType @map("confirmation_snapshot")
  fulfilmentModeSnapshot        FulfilmentMode   @map("fulfilment_mode_snapshot")
  freeCancellationHoursSnapshot Int              @map("free_cancellation_hours_snapshot")
  durationMinutesSnapshot       Int              @map("duration_minutes_snapshot")

  // INDICATIVE, not binding — the one semantic difference
  indicativeUnitInr    BigInt @map("indicative_unit_inr")
  indicativeUnitAed    BigInt @map("indicative_unit_aed")
  indicativeTotalInr   BigInt @map("indicative_total_inr")
  indicativeTotalAed   BigInt @map("indicative_total_aed")
  indicativeNetCostAed BigInt @default(0) @map("indicative_net_cost_aed")

  // agent's confirmed figures, filled during the conversation
  confirmedTotalInr     BigInt?   @map("confirmed_total_inr")
  confirmedTotalAed     BigInt?   @map("confirmed_total_aed")
  confirmedNetCostAed   BigInt?   @map("confirmed_net_cost_aed")
  availabilityCheckedAt DateTime? @map("availability_checked_at") @db.Timestamptz(6)
  availabilityNote      String?   @map("availability_note")

  sortOrder Int @default(0) @map("sort_order")

  inquiry Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  combo   Combo?   @relation(fields: [comboId], references: [id])

  @@index([inquiryId], map: "inquiry_items_inquiry_idx")
  @@index([productId], map: "inquiry_items_product_idx")
  @@map("inquiry_items")
}

/// Pipeline history + agent notes (§17 §6.3). `kind = note` rows are the
/// console's internal notes; `kind = status` rows carry from/to.
model InquiryEvent {
  id         BigInt           @id @default(autoincrement())
  inquiryId  String           @map("inquiry_id") @db.Uuid
  kind       InquiryEventKind @default(status)
  fromStatus InquiryStatus?   @map("from_status")
  toStatus   InquiryStatus?   @map("to_status")
  actorType  ActorType        @map("actor_type")
  actorId    String?          @map("actor_id") @db.Uuid
  note       String?
  meta       Json?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry    Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt], map: "inquiry_events_inquiry_idx")
  @@map("inquiry_events")
}

/// Numbers marked spam by an agent (§17 §7.5 "wrong number / fake lead").
model SuppressedPhone {
  phoneE164 String   @id @map("phone_e164")
  reason    String
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("suppressed_phones")
}

/// Append-only (§05.3.1). Current state = latest row per (phone, channel, purpose).
model Consent {
  id        String         @id @db.Uuid
  phoneE164 String?        @map("phone_e164")
  email     String?
  channel   ConsentChannel
  purpose   ConsentPurpose
  granted   Boolean
  /// 'inquiry_form' | 'stop_keyword' | 'agent' | 'profile'
  source    String
  /// exact copy shown, page URL, ip hash
  evidence  Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneE164, channel, createdAt(sort: Desc)], map: "consents_phone_idx")
  @@map("consents")
}

/**
 * ---------------------------------------------------------------------------
 * Orders — DORMANT → ACTIVE on win (§17 §5.1). Shape per §05.3.5 so that
 * self-serve checkout (future, instant SKUs) and agent conversion share one
 * `order.createOrder(input, actor)`.
 * ------------------------------------------------------------------------
 */

model Guest {
  id        String   @id @db.Uuid
  phoneE164 String   @map("phone_e164")
  email     String?
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders    Order[]

  @@index([phoneE164], map: "guests_phone_idx")
  @@map("guests")
}

model Order {
  id                String            @id @db.Uuid
  /// OUT-482913
  reference         String            @unique
  status            OrderStatus       @default(pending_payment)
  rail              Rail
  guestId           String?           @map("guest_id") @db.Uuid
  createdByAgent    String?           @map("created_by_agent") @db.Uuid
  /// Closes the loop: inquiry → won attribution (§17 §6.4)
  sourceInquiryId   String?           @map("source_inquiry_id") @db.Uuid
  /// 'manual_link' records that a Razorpay Payment Link was sent by hand (§17 §6.4)
  paymentCollection PaymentCollection @default(gateway) @map("payment_collection")

  currency    Currency
  subtotalInr BigInt   @map("subtotal_inr")
  subtotalAed BigInt   @map("subtotal_aed")
  discountInr BigInt   @default(0) @map("discount_inr")
  discountAed BigInt   @default(0) @map("discount_aed")
  taxInr      BigInt   @default(0) @map("tax_inr")
  taxAed      BigInt   @default(0) @map("tax_aed")
  totalInr    BigInt   @map("total_inr")
  totalAed    BigInt   @map("total_aed")
  netCostAed  BigInt   @default(0) @map("net_cost_aed")
  couponCode  String?  @map("coupon_code")

  // traveller snapshot
  leadName        String  @map("lead_name")
  leadEmail       String? @map("lead_email")
  leadPhone       String  @map("lead_phone")
  hotel           String?
  pickupZone      String? @map("pickup_zone")
  dietary         String?
  specialRequests String? @map("special_requests")

  paymentMode    String  @default("full") @map("payment_mode")
  idempotencyKey String? @map("idempotency_key")
  /// Linked on OTP verify when lead_phone equals the verified phone (customer-auth-contract §1).
  customerId     String? @map("customer_id") @db.Uuid

  placedAt    DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  guest         Guest?            @relation(fields: [guestId], references: [id])
  createdBy     AdminUser?        @relation("OrderCreatedByAgent", fields: [createdByAgent], references: [id], onDelete: SetNull)
  sourceInquiry Inquiry?          @relation("OrderSourceInquiry", fields: [sourceInquiryId], references: [id], onDelete: SetNull)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  attribution   OrderAttribution?
  payments      Payment[]
  notifications Notification[]
  fromInquiry   Inquiry?          @relation("InquiryConvertedOrder")
  analytics     AnalyticsEvent[]

  @@index([status, placedAt(sort: Desc)], map: "orders_status_placed_idx")
  @@index([leadPhone], map: "orders_lead_phone_idx")
  @@index([rail, placedAt(sort: Desc)], map: "orders_rail_placed_idx")
  @@index([sourceInquiryId], map: "orders_source_inquiry_idx")
  @@index([customerId], map: "orders_customer_idx")
  @@map("orders")
}

/// IMMUTABLE SNAPSHOT — never joined for display, never recomputed.
model OrderItem {
  id          String  @id @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  comboId     String? @map("combo_id") @db.Uuid
  variantCode String? @map("variant_code")
  mappingId   String? @map("mapping_id") @db.Uuid

  titleSnapshot                 String           @map("title_snapshot")
  tierSnapshot                  String           @map("tier_snapshot") @db.Char(1)
  slugSnapshot                  String           @map("slug_snapshot")
  kindSnapshot                  String           @map("kind_snapshot")
  imageSnapshot                 String?          @map("image_snapshot")
  variantNameSnapshot           String?          @map("variant_name_snapshot")
  inclusionsSnapshot            String[]         @default([]) @map("inclusions_snapshot")
  cancellationPolicySnapshot    Json             @default("{}") @map("cancellation_policy_snapshot")
  confirmationSnapshot          ConfirmationType @map("confirmation_snapshot")
  fulfilmentModeSnapshot        FulfilmentMode   @map("fulfilment_mode_snapshot")
  freeCancellationHoursSnapshot Int              @map("free_cancellation_hours_snapshot")
  durationMinutesSnapshot       Int              @map("duration_minutes_snapshot")

  serviceDate DateTime @map("service_date") @db.Date
  timeslot    String?
  pax         Json
  addons      Json     @default("[]")

  unitInr    BigInt          @map("unit_inr")
  unitAed    BigInt          @map("unit_aed")
  totalInr   BigInt          @map("total_inr")
  totalAed   BigInt          @map("total_aed")
  netCostAed BigInt          @default(0) @map("net_cost_aed")
  status     OrderItemStatus @default(pending)

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  combo   Combo?   @relation(fields: [comboId], references: [id])

  @@index([orderId], map: "order_items_order_idx")
  @@index([serviceDate], map: "order_items_service_date_idx")
  @@map("order_items")
}

/// AC-AN-01: first-touch AND last-touch; fbc/fbclid make offline upload possible (AC-META-02).
model OrderAttribution {
  orderId          String    @id @map("order_id") @db.Uuid
  firstSource      String?   @map("first_source")
  firstMedium      String?   @map("first_medium")
  firstCampaign    String?   @map("first_campaign")
  firstTouchAt     DateTime? @map("first_touch_at") @db.Timestamptz(6)
  lastSource       String?   @map("last_source")
  lastMedium       String?   @map("last_medium")
  lastCampaign     String?   @map("last_campaign")
  lastTouchAt      DateTime? @map("last_touch_at") @db.Timestamptz(6)
  fbclid           String?
  fbc              String?
  fbp              String?
  gclid            String?
  waConversationId String?   @map("wa_conversation_id") @db.Uuid
  uploadedToMetaAt DateTime? @map("uploaded_to_meta_at") @db.Timestamptz(6)
  order            Order     @relation(fields: [orderId], references: [id])

  @@index([uploadedToMetaAt], map: "order_attribution_meta_upload_idx")
  @@map("order_attribution")
}

/// In inquiry mode payments are recorded manually by the agent for
/// reconciliation (§17 §5.1). Gateway webhooks (future) write the same rows.
model Payment {
  id               String        @id @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  /// 'razorpay' — collection via Payment Link is still Razorpay
  gateway          String
  gatewayOrderId   String?       @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  paymentLinkId    String?       @map("payment_link_id")
  paymentLinkUrl   String?       @map("payment_link_url")
  method           String?
  amountMinor      BigInt        @map("amount_minor")
  currency         Currency
  status           PaymentStatus
  failureCode      String?       @map("failure_code")
  failureReason    String?       @map("failure_reason")
  isDeposit        Boolean       @default(false) @map("is_deposit")
  feeMinor         BigInt?       @map("fee_minor")
  taxOnFeeMinor    BigInt?       @map("tax_on_fee_minor")
  recordedBy       String?       @map("recorded_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  capturedAt       DateTime?     @map("captured_at") @db.Timestamptz(6)
  order            Order         @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "payments_order_idx")
  @@map("payments")
}

/**
 * ---------------------------------------------------------------------------
 * Communication — narrow scope (§17 §5.1). BSP transport is a deferred adapter;
 * the tables it will write exist so nothing is redesigned when it arrives.
 * ------------------------------------------------------------------------
 */

model WaConversation {
  id                       String               @id @db.Uuid
  phoneE164                String               @map("phone_e164")
  bspConversationId        String?              @map("bsp_conversation_id")
  status                   WaConversationStatus @default(open)
  assignedAgentId          String?              @map("assigned_agent_id") @db.Uuid
  intent                   String?
  entryContext             Json?                @map("entry_context")
  attribution              Json?
  cswExpiresAt             DateTime?            @map("csw_expires_at") @db.Timestamptz(6)
  freeEntryWindowExpiresAt DateTime?            @map("free_entry_window_expires_at") @db.Timestamptz(6)
  firstResponseAt          DateTime?            @map("first_response_at") @db.Timestamptz(6)
  lastMessageAt            DateTime?            @map("last_message_at") @db.Timestamptz(6)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  assignedAgent            AdminUser?           @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  inquiries                Inquiry[]

  @@index([phoneE164], map: "wa_conversations_phone_idx")
  @@index([status, lastMessageAt(sort: Desc)], map: "wa_conversations_status_idx")
  @@map("wa_conversations")
}

/// Every outbound message, every channel, every outcome (§04.6.3).
model Notification {
  id               String              @id @db.Uuid
  /// INQUIRY_ACK, INQUIRY_OPS_ALERT, INQUIRY_FOLLOWUP, INQUIRY_SLA_BREACH, ...
  event            String
  channel          NotificationChannel
  recipient        String
  inquiryId        String?             @map("inquiry_id") @db.Uuid
  orderId          String?             @map("order_id") @db.Uuid
  template         String?
  payload          Json?
  status           NotificationStatus
  suppressedReason String?             @map("suppressed_reason")
  providerId       String?             @map("provider_id")
  providerError    String?             @map("provider_error")
  costMinor        BigInt?             @map("cost_minor")
  attempt          Int                 @default(1)
  scheduledFor     DateTime?           @map("scheduled_for") @db.Timestamptz(6)
  sentAt           DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt      DateTime?           @map("delivered_at") @db.Timestamptz(6)
  failedAt         DateTime?           @map("failed_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry          Inquiry?            @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([inquiryId, event], map: "notifications_inquiry_event_idx")
  @@index([status, scheduledFor], map: "notifications_status_sched_idx")
  @@map("notifications")
}

/// Raw inbound webhook payloads, persisted first, deduplicated by provider event id (§04.4.3).
model WebhookEvent {
  id              String    @id @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String?   @map("event_type")
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  processingError String?   @map("processing_error")

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

/**
 * ---------------------------------------------------------------------------
 * Analytics — our collector is the source of truth (§11.1)
 * ------------------------------------------------------------------------
 */

model AnalyticsEvent {
  id               String          @id @db.Uuid
  eventId          String          @map("event_id")
  name             String
  occurredAt       DateTime        @map("occurred_at") @db.Timestamptz(6)
  receivedAt       DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  sessionId        String?         @map("session_id")
  anonId           String?         @map("anon_id")
  inquiryId        String?         @map("inquiry_id") @db.Uuid
  orderId          String?         @map("order_id") @db.Uuid
  productSlug      String?         @map("product_slug")
  rail             String?
  tier             String?         @db.Char(1)
  valueMinor       BigInt?         @map("value_minor")
  currency         String?
  props            Json            @default("{}")
  source           AnalyticsSource
  ipHash           String?         @map("ip_hash")
  userAgent        String?         @map("user_agent")
  geoCountry       String?         @map("geo_country")
  environment      String          @default("development")
  forwardedMeta    Boolean         @default(false) @map("forwarded_meta")
  forwardedPosthog Boolean         @default(false) @map("forwarded_posthog")
  forwardedGa4     Boolean         @default(false) @map("forwarded_ga4")
  inquiry          Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([eventId, source])
  @@index([name, occurredAt(sort: Desc)], map: "analytics_events_name_idx")
  @@index([sessionId], map: "analytics_events_session_idx")
  @@index([inquiryId], map: "analytics_events_inquiry_idx")
  @@map("analytics_events")
}

/**
 * ---------------------------------------------------------------------------
 * Infrastructure
 * ------------------------------------------------------------------------
 */

/// Postgres-backed fixed-window rate limiter (§18 §1.6: Redis is optional at
/// launch volumes). Swap for @upstash/ratelimit behind the same port later.
model RateLimitBucket {
  key         String   @map("bucket_key")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([key, windowStart])
  @@index([expiresAt], map: "rate_limit_expires_idx")
  @@map("rate_limit_buckets")
}

model IdempotencyKey {
  key            String    @id
  scope          String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model JobExecution {
  id         String    @id @db.Uuid
  jobType    String    @map("job_type")
  dedupeKey  String    @map("dedupe_key")
  status     JobStatus
  attempt    Int       @default(1)
  error      String?
  payload    Json?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@unique([jobType, dedupeKey])
  @@map("job_executions")
}

/// Resolved Pexels search results per catalogue image ref (image.service.ts).
/// One row per (kind, slug) holds the ordered photo list, so a whole gallery
/// costs one API call. `photos = []` with a recent `fetchedAt` is a negative
/// cache (retried after 24h). Curated ids never touch this table.
model ImageAsset {
  key       String   @id
  query     String
  photos    Json     @default("[]")
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("image_assets")
}
