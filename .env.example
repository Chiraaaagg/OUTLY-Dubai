# =============================================================================
#  OUTLY — environment configuration
# =============================================================================
#
#  HOW TO USE
#  1. Copy this file:            cp .env.example .env.local
#  2. Paste keys one by one.     Leave a value blank to disable that integration
#                                (the app falls back to the mock/log adapter).
#  3. Never commit .env.local.   It is already in .gitignore (.env*.local).
#
#  NAMING
#  NEXT_PUBLIC_*  → shipped to the browser. Only ever put PUBLIC identifiers here
#                   (pixel IDs, site keys, phone numbers). Never a secret.
#  Everything else is server-only.
#
#  ENVIRONMENTS (docs/backend/14-deployment.md §1)
#  dev      → test keys, mock Rathin, log-only WhatsApp, Resend catch-all
#  staging  → test keys, BSP sandbox number, recipient allowlist ON
#  prod     → live keys only here. Never a live payment or BSP credential elsewhere.
#
#  Sections are ordered by launch priority. Phase B (WhatsApp + email ack) is
#  the launchable line per docs/backend/17-inquiry-mode-pivot.md.
# =============================================================================


# -----------------------------------------------------------------------------
#  0. APP
# -----------------------------------------------------------------------------
NODE_ENV=development
# development | staging | production — drives adapter selection and the
# non-production recipient allowlist. Keep in sync with NODE_ENV.
APP_ENV=development

# Canonical origin. Used for absolute URLs in WhatsApp messages, emails,
# sitemap, canonicals and payment-link redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public WhatsApp number for click-to-chat links (digits only, with country code).
# Currently mocked in src/lib/whatsapp.ts → WHATSAPP_NUMBER.
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Displayed on vouchers, support pages and the maintenance page.
NEXT_PUBLIC_EMERGENCY_PHONE=+97140000000
NEXT_PUBLIC_SUPPORT_EMAIL=help@outly.in

# Client analytics transport. src/lib/analytics.ts → deliver() posts here.
# Leave blank to keep events in the in-memory buffer only.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=/api/events


# -----------------------------------------------------------------------------
#  1. DATABASE — Neon Postgres (docs/backend/03 §4, 05)
#  Get: https://console.neon.tech → project → Connection details
#  Use the POOLED connection string for the app (serverless), the DIRECT one
#  for Prisma migrations.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/outly?sslmode=require&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/outly?sslmode=require

# Optional — only for CI to create a DB branch per preview deploy.
NEON_API_KEY=
NEON_PROJECT_ID=


# -----------------------------------------------------------------------------
#  2. CACHE & QUEUE — Upstash (docs/backend/03 §5)
#  Get: https://console.upstash.com → Redis → REST API
#       https://console.upstash.com → QStash → Request builder / Signing keys
# -----------------------------------------------------------------------------
# Redis: availability L1 cache, rate limiting, OTP challenges, idempotency locks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash: every async job (voucher, notifications, CAPI, follow-up ladder).
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
# Used by the shared job wrapper to verify incoming QStash signatures.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=


# -----------------------------------------------------------------------------
#  3. STORAGE — Cloudflare R2 (docs/backend/03 §6)
#  Get: Cloudflare dashboard → R2 → Manage R2 API Tokens
#  Vouchers/tickets → private bucket (signed URLs). Product media → public bucket.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_VOUCHERS=outly-vouchers
R2_BUCKET_MEDIA=outly-media
# Public CDN hostname for the media bucket (custom domain or r2.dev).
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.outly.in
# Seconds a signed voucher URL stays valid.
R2_SIGNED_URL_TTL_SECONDS=900


# -----------------------------------------------------------------------------
#  4. AUTH & SECRETS (docs/backend/13 §2)
#  Generate each with:  openssl rand -base64 48
#  Never reuse a value across two variables.
# -----------------------------------------------------------------------------
# Customer JWT (jose). Rotate = every session invalid.
AUTH_JWT_SECRET=
# httpOnly cookie signing.
AUTH_COOKIE_SECRET=
# Encrypts admin TOTP seeds at rest. Losing this locks every admin out.
TOTP_ENCRYPTION_KEY=
# Session lifetimes.
AUTH_CUSTOMER_SESSION_DAYS=30
AUTH_ADMIN_SESSION_HOURS=8

# Customer phone OTP over SMS — MSG91 (India). DLT template registration is
# mandatory and slow; start it early (docs/backend/13 §2.1).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=OUTLYT
MSG91_TEMPLATE_ID_OTP=
MSG91_DLT_ENTITY_ID=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5


# -----------------------------------------------------------------------------
#  5. WHATSAPP — Business API via BSP (docs/backend/08)
#  This is the launch line (pivot §Appendix Phase B). The automatic inquiry
#  acknowledgement with a concrete deadline cannot exist without it.
#
#  Variable names follow the Meta Cloud API shape; Wati / Interakt / Gupshup /
#  AiSensy all expose equivalents. Set WHATSAPP_PROVIDER to pick the adapter.
# -----------------------------------------------------------------------------
# meta | wati | interakt | gupshup | aisensy | log   (log = dev no-op adapter)
WHATSAPP_PROVIDER=log
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Inbound webhook: Meta verifies with the verify token; payloads are HMAC'd
# with the app secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Pre-approved template names (docs/backend/08 §4). Two needed at launch.
WHATSAPP_TEMPLATE_INQUIRY_ACK=outly_inquiry_ack_v1
WHATSAPP_TEMPLATE_INQUIRY_FOLLOWUP=outly_inquiry_followup_v1
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=outly_booking_confirmed_v1
WHATSAPP_TEMPLATE_VOUCHER=outly_voucher_v1
WHATSAPP_TEMPLATE_DRIVER_DETAILS=outly_driver_details_v1
WHATSAPP_TEMPLATE_REVIEW_REQUEST=outly_review_request_v1

# Ops alert group for new inquiries / SLA breaches (WhatsApp group or number).
WHATSAPP_OPS_ALERT_NUMBER=

# NON-PRODUCTION SAFETY (docs/backend/14 §1 non-negotiable #3): comma-separated
# numbers that may receive messages outside production. Empty = send nothing.
NOTIFICATION_RECIPIENT_ALLOWLIST=


# -----------------------------------------------------------------------------
#  6. EMAIL — Resend (docs/backend/03 §7)
#  Get: https://resend.com/api-keys. Configure SPF/DKIM/DMARC per domain.
#  Transactional and marketing on separate sending domains (PRD §14.4).
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL="OUTLY <hello@mail.outly.in>"
EMAIL_FROM_MARKETING="OUTLY <news@updates.outly.in>"
EMAIL_REPLY_TO=help@outly.in
# Inbound webhook signing secret (delivery/bounce events).
RESEND_WEBHOOK_SECRET=
# Dev/staging: every email is redirected here instead of the real recipient.
EMAIL_CATCH_ALL=


# -----------------------------------------------------------------------------
#  7. PAYMENTS — Razorpay (docs/backend/07)
#  Get: https://dashboard.razorpay.com → Settings → API Keys / Webhooks
#  Inquiry mode: agents generate Payment Links manually; the API keys are still
#  needed for webhook verification, reconciliation and refunds.
#  Use rzp_test_* everywhere except production.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key id is safe in the browser (needed if/when instant checkout is enabled).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_
# Payment link expiry (minutes) for agent-generated links.
RAZORPAY_PAYMENT_LINK_EXPIRY_MINUTES=1440

# UAE / AED gateway — V1, provider TBD (Stripe / Telr / Network International).
# Depends on the OUTLY entity decision (Blocker B5). Leave blank until chosen.
AED_GATEWAY_PROVIDER=
AED_GATEWAY_KEY_ID=
AED_GATEWAY_KEY_SECRET=
AED_GATEWAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
#  8. SUPPLIER APIS (docs/backend/02, 16)
#  Rathin is NOT READY per docs/backend/16 — keep the mock adapter until the
#  Phase 2b validation gate passes. Flipping a SKU to fulfilment_mode='instant'
#  is what turns these on for that SKU.
# -----------------------------------------------------------------------------
# mock | rathin
SUPPLIER_ADAPTER_RATHIN=mock
RATHIN_BASE_URL=
RATHIN_CLIENT_ID=
RATHIN_CLIENT_SECRET=
RATHIN_AGENCY_ID=
# Per-call timeout budget (docs/backend/02 §5.2). Never rely on the platform ceiling.
RATHIN_TIMEOUT_MS=8000
# Availability cache TTL (seconds). Always 0 at payment authorisation.
AVAILABILITY_CACHE_TTL_SECONDS=300


# -----------------------------------------------------------------------------
#  9. ANALYTICS (docs/backend/11)
#  Our own /api/events is the source of truth; these are downstream forwarders.
# -----------------------------------------------------------------------------
# PostHog Cloud — product analytics, funnels, cohorts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side project API key (may equal the public key on PostHog).
POSTHOG_API_KEY=

# GA4 — measurement id is public; the API secret (Measurement Protocol) is not.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-
GA4_API_SECRET=

# Meta — pixel id is public; CAPI token is server-only.
# In inquiry mode: inquiry_submitted → Lead (CAPI), booking_confirmed → Purchase
# via OFFLINE conversion upload (essential — pivot §5.3).
NEXT_PUBLIC_META_PIXEL_ID=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
# Sends CAPI events to Meta's test tool instead of live optimisation. Blank in prod.
META_CAPI_TEST_EVENT_CODE=
# Marketing API — offline conversion uploads + catalogue feed.
META_MARKETING_API_TOKEN=
META_AD_ACCOUNT_ID=act_
META_OFFLINE_EVENT_SET_ID=


# -----------------------------------------------------------------------------
# 10. ERROR TRACKING — Sentry
#  Get: https://sentry.io → project → Client Keys (DSN); Settings → Auth Tokens
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=outly
# CI only — uploads source maps on build.
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1


# -----------------------------------------------------------------------------
# 11. SECURITY & ABUSE CONTROLS (docs/backend/13, pivot §9)
# -----------------------------------------------------------------------------
# Cloudflare Turnstile — deliberately OFF at launch (conversion cost). Add only
# when spam actually appears. Blank site key = widget not rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inquiry form anti-spam (honeypot + timing are always on).
INQUIRY_MIN_SUBMIT_SECONDS=2
INQUIRY_RATE_LIMIT_PER_PHONE_PER_HOUR=3
INQUIRY_RATE_LIMIT_PER_IP_PER_HOUR=10
# Booking / inquiry lookup by reference: 5 per IP per 15 minutes.
LOOKUP_RATE_LIMIT_PER_IP=5
LOOKUP_RATE_LIMIT_WINDOW_SECONDS=900

# Shared secret for Vercel Cron → route handler calls (Authorization: Bearer).
CRON_SECRET=
# Internal service-to-service key (admin console → API).
INTERNAL_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# 12. OPERATIONS — inquiry SLA & routing (pivot §3.9, §7)
#  Admin-editable in production (settings.sla.*); these are boot defaults.
# -----------------------------------------------------------------------------
SLA_INQUIRY_RESPONSE_MINUTES=30
SLA_BUSINESS_HOURS_START=09:00
SLA_BUSINESS_HOURS_END=23:00
SLA_TIMEZONE=Asia/Kolkata
# Escalate to agent lead + reassign when breached.
SLA_ESCALATION_MINUTES=30
# Routing thresholds (pivot §7.3).
ROUTING_PREMIUM_THRESHOLD_INR=100000
ROUTING_GROUP_THRESHOLD_PAX=5
AGENT_MAX_CONCURRENT_INQUIRIES=15

# Follow-up ladder (hours). T+2h nudge, T+24h softer option, T+72h final, T+7d lost.
FOLLOWUP_LADDER_HOURS=2,24,72,168

# Indicative → confirmed price tolerance before re-consent is required (pivot §10.4).
PRICE_TOLERANCE_PERCENT=5

# Ops alert channel for P1s (Slack incoming webhook or email).
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_EMAIL=ops@outly.in


# -----------------------------------------------------------------------------
# 13. FEATURE FLAGS
#  Per-product fulfilment mode lives in the DB (products.fulfilment_mode) —
#  never as a global env flag (pivot §8.4). These are runtime toggles only.
# -----------------------------------------------------------------------------
# Block /design-system outside dev (docs/backend/14 §1).
FEATURE_DESIGN_SYSTEM_PAGE=true
# Show the response-time promise on the homepage. Turn on only once the SLA
# timer and weekly measurement exist (pivot §3.9).
FEATURE_RESPONSE_PROMISE=true
# Maintenance mode — serves /maintenance for all storefront routes.
FEATURE_MAINTENANCE_MODE=false
# Enables the instant-checkout route even if no SKU is flipped (testing only).
FEATURE_FORCE_CHECKOUT_ROUTE=false
